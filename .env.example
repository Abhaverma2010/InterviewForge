# ─── LLM ───────────────────────────────────────────────────────────────
# Any OpenAI-compatible chat-completions endpoint works. Default: Google Gemini
# (free tier, get a key at https://aistudio.google.com/apikey).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
# Use the Flash model id shown in AI Studio.
LLM_MODEL=gemini-2.5-flash

# ─── Database / sessions ──────────────────────────────────────────────
# MongoDB Atlas connection string (free M0 cluster is enough).
MONGODB_URI=mongodb://127.0.0.1:27017/interviewforge
# Long random string used to sign session cookies.
SESSION_SECRET=change-me

# ─── API server ───────────────────────────────────────────────────────
PORT=4000
# Origin of the Next.js frontend, for CORS.
WEB_ORIGIN=http://localhost:3000

# ─── Crawler ──────────────────────────────────────────────────────────
# Allow fetching localhost / private IPs. true for local dev and the batch
# evaluator (test sites are served on localhost); false in production.
ALLOW_PRIVATE_URLS=true
