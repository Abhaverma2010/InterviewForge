# Copy to .env (or run `npm run setup`) and fill in LLM_API_KEY at least.
# Every variable is documented here; the deployed services set the same names
# in their dashboards (see README, "Deployment").

# ─── LLM ───────────────────────────────────────────────────────────────
# Any OpenAI-compatible chat-completions endpoint works. Default: Google Gemini
# (free tier, get a key at https://aistudio.google.com/apikey).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
# Use the Flash model id shown in AI Studio.
LLM_MODEL=gemini-3.6-flash
# Stay under the free tier's requests-per-minute limit (check AI Studio).
LLM_REQUESTS_PER_MINUTE=8

# Optional fallback, used when the primary model is overloaded (503) or out of
# quota (429). On Gemini's free tier each model has its own quota, so a second
# model with the same key works well. `npm run models` lists the ones your key can use.
# LLM_FALLBACK_BASE_URL and LLM_FALLBACK_API_KEY default to the primary's.
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_REQUESTS_PER_MINUTE=

# ─── Database / sessions ──────────────────────────────────────────────
# MongoDB Atlas connection string (free M0 cluster is enough). Leave empty to
# run the API with an in-memory store (data is lost on restart).
MONGODB_URI=
# Long random string used to sign session cookies.
SESSION_SECRET=change-me

# ─── API server ───────────────────────────────────────────────────────
PORT=4000
# Origin of the Next.js frontend (allowed for direct cross-origin calls).
WEB_ORIGIN=http://localhost:3000
# How many kits generate at the same time. Keep low on a free LLM tier.
GENERATION_CONCURRENCY=2
# Set to "production" when deployed: secure cookies, and MONGODB_URI and a
# strong SESSION_SECRET (32+ random characters) become mandatory.
NODE_ENV=development

# ─── Web app (apps/web) ───────────────────────────────────────────────
# Where the Next.js app forwards /api/* requests. Read at build time.
# Local default: http://localhost:4000. On Vercel: the Render API URL.
# API_ORIGIN=http://localhost:4000

# ─── Crawler ──────────────────────────────────────────────────────────
# Allow the web app's crawler to fetch localhost / private IPs. Must be false
# in production (protects against SSRF). The batch evaluator allows them
# unless this is explicitly "false", because its test sites run on localhost.
ALLOW_PRIVATE_URLS=true

# ─── Demo ─────────────────────────────────────────────────────────────
# true: create the demo account (demo@interviewforge.dev) with ready-made kits
# when the API starts, if it does not exist yet. reset: recreate it on every
# start. false: never. With MongoDB you can also run `npm run seed:demo` once.
SEED_DEMO=false
